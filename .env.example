# NyayaSahayak AI - Environment Variables

# Backend Port (Default 5000)
PORT=5000

# Secret Key for Flask Session
SECRET_KEY=nyayasahayak-ai-sih2026-secret-key

# SQLite Database Location
DATABASE_PATH=database/nyayasahayak.db

# Optional External LLM Provider ('auto', 'gemini', 'openai', 'mock')
# If no key is provided, the platform automatically utilizes its rich Indian Legal Knowledge Base Engine.
AI_PROVIDER=auto
GEMINI_API_KEY=
OPENAI_API_KEY=
